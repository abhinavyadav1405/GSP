rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userId() { return request.auth.token.gspUserId; }
    function isOwner(id) { return signedIn() && userId() == id; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    function reportOnly() {
      let oldReports = resource.data.keys().hasAny(['reports']) ? resource.data.reports : [];
      let newReports = request.resource.data.reports;
      let appended = newReports[newReports.size() - 1];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reports', 'moderationStatus'])
        && newReports is list
        && newReports.size() == oldReports.size() + 1
        && newReports.hasAll(oldReports)
        && appended is map
        && appended.userId == userId()
        && appended.reason in [
          'गलत या झूठी जानकारी',
          'अश्लील या अनुचित वीडियो',
          'गाली-गलौज या उत्पीड़न',
          'स्पैम या बार-बार एक ही पोस्ट',
          'गाँव की समस्या से संबंधित नहीं',
          'अन्य'
        ]
        && request.resource.data.moderationStatus == 'reported';
    }

    match /users/{id} {
      allow read: if true;
      allow create: if isOwner(id) && !request.resource.data.keys().hasAny(['passwordHash', 'salt']);
      allow update: if isOwner(id) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['passwordHash', 'salt']);
      allow delete: if isAdmin();
    }
    match /userCredentials/{id} {
      allow read, write: if false;
    }
    match /problems/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.authorId == userId();
      allow update: if isAdmin()
        || (signedIn() && reportOnly())
        || (signedIn() && resource.data.authorId == userId()
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolutionChallenge', 'resolutionChallengeAt', 'resolvedAt'])
          && request.resource.data.status == 'In Progress'
          && request.resource.data.resolutionChallenge.userId == userId()
          && request.resource.data.resolutionChallenge.reason is string);
      allow delete: if isAdmin() || (signedIn() && resource.data.authorId == userId());
    }
    match /reels/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerId == userId()
        && request.resource.data.moderationStatus == 'visible'
        && request.resource.data.videoDeleted == false;
      allow update: if isAdmin()
        || (signedIn() && reportOnly())
        || (signedIn() && resource.data.ownerId == userId()
          && request.resource.data.ownerId == resource.data.ownerId
          && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption'])
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['challengedAt', 'challengeReason', 'resolvedAt'])
              && request.resource.data.challengeReason is string
              && request.resource.data.resolvedAt == null
          ));
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == userId());
    }
    match /userWarnings/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == userId());
      allow create, update, delete: if isAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /blockedUsers/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
