rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // This claim must be issued only by a trusted server after admin verification.
    // Never let the browser write its own custom claims.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /problems/{problemId} {
      allow read: if true;
      // Public complaints are supported by the app's anonymous-auth flow.
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      // This UID-based rule becomes usable only after the custom-ID account migration.
      allow read, create, update: if isAdmin() ||
        (signedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    match /blockedUsers/{mobile} {
      allow read, write: if isAdmin();
    }

    // All collections not explicitly listed above are denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
